# Build-time settings (copy to .env or .env.local).
# Defaults in src/lib/config.ts already target Stellar testnet — only set what you override.

# --- Network ---
# VITE_NETWORK_NAME=Stellar Testnet
# VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# VITE_RPC_URL=https://soroban-testnet.stellar.org
# VITE_EXPLORER_URL=https://stellar.expert/explorer/testnet

# --- Trustline ---
# Chain id the backend uses for this network (1=mainnet, 2=testnet, 3=futurenet)
# VITE_BACKEND_CHAIN_ID=2
# VITE_TRUSTLINE_CLIENT_ID=trustline-vault-app
# VITE_TRUSTLINE_DASHBOARD_URL=https://onboarding.trustline.id/

# Registry on this network (baked into TrustlineOracleVE WASM; also shown in the UI)
# VITE_TRUSTLINE_REGISTRY=CAOQSLSB4LGPE4JYWTCVURE76LQC5IZUOWLU3NLELXXD6ATNV6B6LHRT

# --- Contract code (sha256 of WASM uploaded on testnet) ---
# TrustlineOracleVE — from stellar-validation-engine deployments.json
# VITE_WASM_ENGINE=d975aa687bcc029bcce7fb8c293a5b4745cd7db980270ec10f32682d8256962e

# Reference vault + dummy adapter — from stellar-vault@80700c5 (wasm-hashes.txt)
# VITE_WASM_VAULT=ebdf2634891ab4f6d709541f22de32c5812da05433b584a9c9e6328679e13c4d
# VITE_WASM_REFERENCE_ADAPTER=5e3b9d8081d3c10d883b66ddb3441c88a08796c80d4994786e4e9902b8e00700
